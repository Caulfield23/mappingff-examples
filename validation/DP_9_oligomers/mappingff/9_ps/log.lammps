LAMMPS (29 Aug 2024 - Update 3)
# ============================================================
# AAMD PA eq_hi stage (Stage 1 of 2).
#
# Reads the packed data file, runs energy minimization, then
# iso-compresses the box to vol_ratio * V0 via manual `fix deform`
# at T_eq, and equilibrates the dense state with NPT at T_eq.
# Writes `eq_hi.restart` so the cool+eq_lo stage can resume from
# the equilibrated high-T dense state.
#
# Override defaults via -var on the command line. Variable
# `datafile` (index style) is set by the job script; numeric
# variables (equal style) can be overridden freely.
# ============================================================

# ---------------- User-tunable parameters ----------------
variable T_eq        equal 400.0       # K  (high-T equilibration)
variable T_def       equal 300.0       # K  (low-T target after cooling)

# Deform stage: iso compression at T_eq
variable vol_ratio   equal 0.125       # target V/V0 (default 1/8)
variable lin_ratio   equal 0.5         # = vol_ratio^(1/3); if you change
                                       # vol_ratio, update this too
variable strain      equal ${lin_ratio}-1.0    # engineering strain (<0 = compression)
variable strain      equal 0.5-1.0    
variable t_deform    equal 400.0      # ps  (deform duration)
variable t_eq_hi     equal 100.0      # ps  (NPT @ T_eq after deform)
variable t_cool      equal 500.0      # ps  (cooling 400 -> 300 K)
variable t_eq_lo     equal 500.0       # ps  (NPT @ T_def after cooling)
variable t_eq_lo_nvt equal 500.0       # ps  (NVT @ T_def after cooling)

# NPT/NVT damping constants (fs)
variable Tdamp       equal 1000.0
variable Pdamp       equal 20000.0
variable dt          equal 1.0         # fs

# ---------------- Files (overridden by -var) ----------------
variable datafile    index filled.data
variable trajfile    index dump.lammpstrj
variable restartfile index final.restart

# ---------------- Step counts (fs -> steps) ----------------
variable steps_deform equal ${t_deform}*1000/${dt}
variable steps_deform equal 400*1000/${dt}
variable steps_deform equal 400*1000/1
variable steps_eq_hi   equal ${t_eq_hi}*1000/${dt}
variable steps_eq_hi   equal 100*1000/${dt}
variable steps_eq_hi   equal 100*1000/1
variable steps_cool   equal ${t_cool}*1000/${dt}
variable steps_cool   equal 500*1000/${dt}
variable steps_cool   equal 500*1000/1
variable steps_eq_lo   equal ${t_eq_lo}*1000/${dt}
variable steps_eq_lo   equal 500*1000/${dt}
variable steps_eq_lo   equal 500*1000/1
variable steps_eq_lo_nvt equal ${t_eq_lo_nvt}*1000/${dt}
variable steps_eq_lo_nvt equal 500*1000/${dt}
variable steps_eq_lo_nvt equal 500*1000/1

# Strain rate (1/fs) for fix deform erate
variable erate        equal ${strain}/(${t_deform}*1000.0)
variable erate        equal -0.5/(${t_deform}*1000.0)
variable erate        equal -0.5/(400*1000.0)

# ============================================================
# Section A. Basic settings
# ============================================================
units           real
atom_style      full
boundary        p p p
timestep        ${dt}
timestep        1

bond_style      harmonic
angle_style     harmonic
dihedral_style  opls
improper_style  cvff
special_bonds   lj/coul 0.0 0.0 0.5

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

pair_style      lj/cut/coul/long 12.0
pair_modify     mix geometric

kspace_style    pppm 1.0e-4

read_data       ${datafile}
read_data       filled.data
