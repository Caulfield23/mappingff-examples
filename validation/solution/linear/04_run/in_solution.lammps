# ============================================================
# Single-chain PS / cyclohexane simulation
# minimize -> NPT density equilibration -> NVT production
# LAMMPS 29 Aug 2024 Update 3 compatible
# ============================================================

# ---------------- User parameters ----------------
variable T equal 307.65       # K, PS/cyclohexane theta-like condition
variable dt equal 1.0         # fs

variable P equal 1.0          # atm
variable Tdamp equal 100.0
variable Pdamp equal 3000.0
variable rcut equal 10.0

variable dumpN equal 4000
variable thermoN equal 2000

variable npt_steps equal 2000000
variable nvt_steps equal 20000000

variable restart_steps equal 50000

# ---------------- Basic settings ----------------
units real
atom_style full
boundary p p p
timestep ${dt}

# ---------------- Bonded interactions ----------------
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.5

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------------- Nonbonded interactions ----------------
pair_style lj/cut/coul/long ${rcut} ${rcut}
pair_modify mix geometric

kspace_style pppm 1.0e-4

# ============================================================
# Stage 0: read data
# ============================================================

read_data system.data
# comm_modify cutoff 30

group polymer molecule 1
group solvent subtract all polymer

# ---- energy minimization ----
min_style cg
minimize 1.0e-7 1.0e-10 1000 10000

# ---- initial velocities ----
velocity all create ${T} 1214 dist gaussian mom yes rot yes

# ---- trajectory output (whole dynamics) ----
dump DUMPTRJ all custom ${dumpN} traj.lammpstrj id mol type q x y z ix iy iz
dump_modify DUMPTRJ sort id

# ============================================================
# Stage 2: NPT equilibration (density relaxation)
# ============================================================

fix NPT all npt temp ${T} ${T} ${Tdamp} iso ${P} ${P} ${Pdamp}

# ---- periodic restart for crash recovery ----
restart ${restart_steps} restart_npt1 restart_npt2

# ---- density / box output during NPT ----
variable rho equal density
variable lxv equal lx
variable lyv equal ly
variable lzv equal lz
variable Pinst equal press
fix RHONPT all ave/time 1000 10 10000 v_rho v_lxv v_lyv v_lzv v_Pinst file physical_npt.dat

# ---- thermo output ----
thermo ${thermoN}
thermo_style custom step temp press density lx ly lz pe enthalpy

run ${npt_steps}

unfix NPT
unfix RHONPT

write_data eq_npt.data
write_restart restart_NPT_final.restart


# ============================================================
# Stage 3: NVT production (Rg, MSD, output)
# ============================================================

fix NVT all nvt temp ${T} ${T} ${Tdamp}

# ---- periodic restart for NVT stage ----
restart ${restart_steps} restart_nvt1 restart_nvt2

# ------------------------------------------------------------
# Radius of gyration of the single PS chain
# ------------------------------------------------------------
compute RgPoly polymer gyration
variable Rg2 equal c_RgPoly*c_RgPoly

# ------------------------------------------------------------
# Mean-square displacement
# c_MSDPoly[4]: atom-averaged polymer MSD with global COM drift removed
# c_MSDSolv[4]: atom-averaged solvent MSD with global COM drift removed
# v_MSDPolyCOM: polymer center-of-mass MSD from the start of NVT
# ------------------------------------------------------------
compute MSDPoly polymer msd com yes
compute MSDSolv solvent msd com yes

run 0
variable xcm_now equal xcm(polymer,x)
variable ycm_now equal xcm(polymer,y)
variable zcm_now equal xcm(polymer,z)
variable xcm0 equal ${xcm_now}
variable ycm0 equal ${ycm_now}
variable zcm0 equal ${zcm_now}
variable MSDPolyCOM equal (xcm(polymer,x)-v_xcm0)^2+(xcm(polymer,y)-v_ycm0)^2+(xcm(polymer,z)-v_zcm0)^2

fix RGMDS all ave/time 1000 10 10000 c_RgPoly v_Rg2 c_MSDPoly[4] v_MSDPolyCOM c_MSDSolv[4] file rg_msd_nvt.dat

thermo ${thermoN}
thermo_style custom step temp press etotal density c_RgPoly v_Rg2 c_MSDPoly[4] v_MSDPolyCOM c_MSDSolv[4]

# ------------------------------------------------------------
# NVT production run
# ------------------------------------------------------------
run ${nvt_steps}

write_data final.data
write_restart restart_NVT_final.restart
