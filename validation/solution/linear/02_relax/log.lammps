# ---- spans of atom bounding box ----
variable Lx equal (c_xmax-c_xmin)
variable Ly equal (c_ymax-c_ymin)
variable Lz equal (c_zmax-c_zmin)

# ---- choose the maximum span ----
variable Lraw equal v_Lx
if "$(v_Ly) > $(v_Lraw)" then "variable Lraw equal v_Ly"
if "$(v_Lz) > $(v_Lraw)" then "variable Lraw equal v_Lz"

# ---- final cubic box length with padding ----
variable Lbox equal (v_Lraw+2.0*v_pad)

# ---- current box center ----
variable xmid equal (0.5*(xlo+xhi))
variable ymid equal (0.5*(ylo+yhi))
variable zmid equal (0.5*(zlo+zhi))

# ---- define new cubic box ----
variable nxlo equal (v_xmid-0.5*v_Lbox)
variable nxhi equal (v_xmid+0.5*v_Lbox)
variable nylo equal (v_ymid-0.5*v_Lbox)
variable nyhi equal (v_ymid+0.5*v_Lbox)
variable nzlo equal (v_zmid-0.5*v_Lbox)
variable nzhi equal (v_zmid+0.5*v_Lbox)


change_box all x final ${nxlo} ${nxhi} y final ${nylo} ${nyhi} z final ${nzlo} ${nzhi} units box
change_box all x final -273.5722 ${nxhi} y final ${nylo} ${nyhi} z final ${nzlo} ${nzhi} units box
change_box all x final -273.5722 39.5865 y final ${nylo} ${nyhi} z final ${nzlo} ${nzhi} units box
change_box all x final -273.5722 39.5865 y final -147.85145 ${nyhi} z final ${nzlo} ${nzhi} units box
change_box all x final -273.5722 39.5865 y final -147.85145 165.30725 z final ${nzlo} ${nzhi} units box
change_box all x final -273.5722 39.5865 y final -147.85145 165.30725 z final -192.7097 ${nzhi} units box
change_box all x final -273.5722 39.5865 y final -147.85145 165.30725 z final -192.7097 120.449 units box
