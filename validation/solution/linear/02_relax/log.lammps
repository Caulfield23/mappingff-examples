LAMMPS (2 Aug 2023 - Update 2)
# ============================================================
# Polymer melt simulation (NO soft, NO hybrid, cubic by design)
# LAMMPS 29 Aug 2024 Update 3 compatible
# ============================================================

# ---------------- User parameters ----------------
variable T equal 500.0       # K
variable dt equal 1.0        # fs

variable Tdamp equal 100.0
variable rcut equal 10.0

# Box padding for initial expansion to cubic box. This is needed to avoid
variable pad equal 30.0

variable dumpN equal 1000
variable thermoN equal 2000

variable nvt_steps equal 50000

# ---------------- Basic settings ----------------
units real
atom_style full
boundary p p p
timestep ${dt}
timestep 1

# ---------------- Bonded interactions ----------------
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.5

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------------- Nonbonded interactions ----------------
pair_style lj/cut/coul/long ${rcut} ${rcut}
pair_style lj/cut/coul/long 10 ${rcut}
pair_style lj/cut/coul/long 10 10
pair_modify mix geometric

kspace_style pppm 1.0e-4

read_data ps_linear.data
