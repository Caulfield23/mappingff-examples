# ---- initial velocities ----
velocity all create ${T} 12345 dist gaussian mom yes rot yes
velocity all create 500 12345 dist gaussian mom yes rot yes

# ---- trajectory output (whole dynamics) ----
dump DUMPTRJ all custom ${dumpN} relax.lammpstrj id mol type q x y z ix iy iz
dump DUMPTRJ all custom 1000 relax.lammpstrj id mol type q x y z ix iy iz
dump_modify DUMPTRJ sort id

fix NVT all nvt temp ${T} ${T} ${Tdamp}
fix NVT all nvt temp 500 ${T} ${Tdamp}
fix NVT all nvt temp 500 500 ${Tdamp}
fix NVT all nvt temp 500 500 100

thermo ${thermoN}
thermo 2000
thermo_style custom step temp etotal

run ${nvt_steps}
run 50000
