# ============================================================
# Polymer melt simulation (NO soft, NO hybrid, cubic by design)
# LAMMPS 29 Aug 2024 Update 3 compatible
# ============================================================

# ---------------- User parameters ----------------
variable T equal 500.0       # K
variable dt equal 1.0        # fs

variable Tdamp equal 100.0
variable rcut equal 10.0

# Box padding for initial expansion to cubic box. This is needed to avoid
variable pad equal 30.0

variable dumpN equal 1000
variable thermoN equal 2000

variable nvt_steps equal 50000

# ---------------- Basic settings ----------------
units real
atom_style full
boundary p p p
timestep ${dt}

# ---------------- Bonded interactions ----------------
bond_style harmonic
angle_style harmonic
dihedral_style opls
improper_style cvff
special_bonds lj 0.0 0.0 0.5 coul 0.0 0.0 0.5

neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes

# ---------------- Nonbonded interactions ----------------
pair_style lj/cut/coul/long ${rcut} ${rcut}
pair_modify mix geometric

kspace_style pppm 1.0e-4

read_data ps_linear.data

# ---- compute atomic bounding box ----
compute xmin all reduce min x
compute xmax all reduce max x
compute ymin all reduce min y
compute ymax all reduce max y
compute zmin all reduce min z
compute zmax all reduce max z
run 0

# ---- spans of atom bounding box ----
variable Lx equal (c_xmax-c_xmin)
variable Ly equal (c_ymax-c_ymin)
variable Lz equal (c_zmax-c_zmin)

# ---- choose the maximum span ----
variable Lraw equal v_Lx
if "$(v_Ly) > $(v_Lraw)" then "variable Lraw equal v_Ly"
if "$(v_Lz) > $(v_Lraw)" then "variable Lraw equal v_Lz"

# ---- final cubic box length with padding ----
variable Lbox equal (v_Lraw+2.0*v_pad)

# ---- current box center ----
variable xmid equal (0.5*(xlo+xhi))
variable ymid equal (0.5*(ylo+yhi))
variable zmid equal (0.5*(zlo+zhi))

# ---- define new cubic box ----
variable nxlo equal (v_xmid-0.5*v_Lbox)
variable nxhi equal (v_xmid+0.5*v_Lbox)
variable nylo equal (v_ymid-0.5*v_Lbox)
variable nyhi equal (v_ymid+0.5*v_Lbox)
variable nzlo equal (v_zmid-0.5*v_Lbox)
variable nzhi equal (v_zmid+0.5*v_Lbox)


change_box all x final ${nxlo} ${nxhi} y final ${nylo} ${nyhi} z final ${nzlo} ${nzhi} units box
run 0

# ---- energy minimization ----
min_style cg
minimize 1.0e-7 1.0e-10 1000 10000

# ---- initial velocities ----
velocity all create ${T} 12345 dist gaussian mom yes rot yes

# ---- trajectory output (whole dynamics) ----
dump DUMPTRJ all custom ${dumpN} relax.lammpstrj id mol type q x y z ix iy iz
dump_modify DUMPTRJ sort id

fix NVT all nvt temp ${T} ${T} ${Tdamp}

thermo ${thermoN}
thermo_style custom step temp etotal

run ${nvt_steps}
write_data relaxed.data

